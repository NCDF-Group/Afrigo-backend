{
  "name": "afrigo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Afrigo API for the web app, the mobile apps and the admin console.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:seed:admin": "node --env-file-if-exists=.env --import tsx src/db/seed-admin.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:admin:prod": "node dist/db/seed-admin.js",
    "start:render": "npm run db:migrate:prod && npm start"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vitest": "^5.0.2"
  }
}
